# LLM provider. Groq is the default for this assignment.
# Never expose this value to the browser.
GROQ_API_KEY=

# Groq model id. llama-3.3-70b is retired; gpt-oss-120b is the current default.
GROQ_MODEL=openai/gpt-oss-120b

# Agent mode uses tool-calling with up to 5 steps. Set to false to use the legacy intent router.
AGENT_MODE=true

# Guest sessions and booking holds are stored in data/sessions.json and data/bookings.json.
# Staff escalations are stored in data/escalations.json.
# On Vercel, writable copies are kept in /tmp/asteria-data. Override with DATA_DIR if needed.

# Stream agent replies over SSE with live tool-status updates. Set to false to use JSON responses.
STREAM_MODE=true

# Optional fallback if GROQ_API_KEY is empty.
AI_GATEWAY_API_KEY=
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.4-mini

# Staff dashboard. Defaults to asteria-desk in local development.
STAFF_PASSWORD=asteria-desk
STAFF_SECRET=

# Optional webhook for new guest escalations (Slack, Discord, Zapier, etc.).
STAFF_ALERT_WEBHOOK=
